{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [{"type": "command", "command": "\"${ALMANAC_PYTHON:-python}\" \"${CLAUDE_PLUGIN_ROOT}/scripts/config_guard.py\"", "timeout": 10}]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{"type": "command", "command": "\"${ALMANAC_PYTHON:-python}\" \"${CLAUDE_PLUGIN_ROOT}/scripts/no_verify_guard.py\"", "timeout": 10}]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{"type": "command", "command": "\"${ALMANAC_PYTHON:-python}\" \"${CLAUDE_PLUGIN_ROOT}/scripts/suite_guard.py\"", "timeout": 10}]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{"type": "command", "command": "\"${ALMANAC_PYTHON:-python}\" \"${CLAUDE_PLUGIN_ROOT}/scripts/builder_git_guard.py\"", "timeout": 10}]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [{"type": "command", "command": "\"${ALMANAC_PYTHON:-python}\" \"${CLAUDE_PLUGIN_ROOT}/scripts/plan_guard.py\"", "timeout": 10}]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{"type": "command", "command": "\"${ALMANAC_PYTHON:-python}\" \"${CLAUDE_PLUGIN_ROOT}/scripts/delegate_guard.py\"", "timeout": 10}]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [{"type": "command", "command": "\"${ALMANAC_PYTHON:-python}\" \"${CLAUDE_PLUGIN_ROOT}/scripts/brief_guard.py\"", "timeout": 10}]
      }
    ]
  }
}
