{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${ALMANAC_PYTHON:-python}\" \"${CLAUDE_PLUGIN_ROOT}/scripts/plan_mode.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"${ALMANAC_PYTHON:-python}\" \"${CLAUDE_PLUGIN_ROOT}/scripts/plan_mode.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
